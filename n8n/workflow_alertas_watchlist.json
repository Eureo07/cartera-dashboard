      "name": "Split tickers",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "=https://query1.finance.yahoo.com/v8/finance/chart/{{ $json.ticker }}",
        "options": {}
      },
      "id": "http2",
      "name": "Precio actual Yahoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const alerta = $('Split tickers').item.json;\nconst priceData = $json;\n\nlet currentPrice = null;\ntry {\n  currentPrice = priceData.chart.result[0].meta.regularMarketPrice;\n} catch(e) {}\n\nconst today = new Date();\nconst isFriday = today.getDay() === 5;\n\nlet condicionCumplida = false;\n\nif (alerta.tipo_entrada === 'LT' || alerta.tipo_entrada === 'LTA' || alerta.tipo_entrada === 'MA') {\n  if (currentPrice !== null && alerta.precio_trigger) {\n    condicionCumplida = currentPrice <= alerta.precio_trigger * 1.01;\n    if (alerta.requiere_cierre_semanal && !isFriday) {\n      condicionCumplida = false;\n    }\n  }\n} else if (alerta.tipo_entrada === 'RR' || alerta.tipo_entrada === 'RRA') {\n  if (currentPrice !== null && alerta.precio_trigger) {\n    condicionCumplida = currentPrice >= alerta.precio_trigger;\n    if (alerta.requiere_cierre_semanal && !isFriday) {\n      condicionCumplida = false;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    ...alerta,\n    precio_actual: currentPrice,\n    condicion_cumplida: condicionCumplida,\n    es_viernes: isFriday\n  }\n}];"
      },
      "id": "code1",
      "name": "Comparar trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            { "leftValue": "={{$json.condicion_cumplida}}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } },
            { "leftValue": "={{$json.alertado}}", "rightValue": false, "operator": { "type": "boolean", "operation": "equals" } }
          ]
        }
      },
      "id": "if1",
      "name": "IF dispara alerta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "sendTo": "TU-EMAIL@gmail.com",
        "subject": "=🔔 Alerta watchlist: {{$json.ticker}} ha alcanzado nivel de entrada",
        "message": "=Ticker: {{$json.ticker}}\nTag: {{$json.tag}}\nTipo señal: {{$json.tipo_entrada}}\nPrecio trigger: {{$json.precio_trigger}}\nPrecio actual: {{$json.precio_actual}}\n\nRecuerda confirmar en el dashboard antes de operar (cierre semanal del viernes si aplica).",
        "options": {}
      },
      "id": "gmail1",
      "name": "Enviar email Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1560, 220],
      "credentials": { "gmailOAuth2": { "id": "PENDIENTE", "name": "Gmail account" } }
    },
